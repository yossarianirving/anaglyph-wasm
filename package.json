{
    "name": "anaglyph-wasm",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Browser video to anaglyph 3-D converter (WebGPU + wasm/WebCodecs) with a worker-based API",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yossarianirving/anaglyph-wasm.git"
    },
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "default": "./index.js"
        },
        "./wasm": "./js/video-pipeline.js",
        "./gpu": "./gpu-video/gpu-pipeline.js",
        "./encoder-plan": "./js/encoder-plan.js",
        "./workers/video": "./workers/video-worker.js",
        "./workers/gpu": "./workers/gpu-worker.js",
        "./pkg/anaglyph_wasm_bg.wasm": "./pkg/anaglyph_wasm_bg.wasm",
        "./package.json": "./package.json"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "js/",
        "gpu-video/",
        "workers/",
        "pkg/",
        "vendor/",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "scripts/build-wasm.sh",
        "build:wasm:scalar": "scripts/build-wasm.sh --scalar",
        "serve": "python3 -m http.server 8000",
        "test": "node --test js/ gpu-video/",
        "vendor": "cp node_modules/mediabunny/dist/bundles/mediabunny.min.mjs vendor/mediabunny.mjs && cp node_modules/mediabunny/dist/mediabunny.d.ts vendor/mediabunny.d.ts"
    },
    "devDependencies": {
        "mediabunny": "^1.65.2",
        "playwright": "1.65"
    }
}
