{
    "name": "anaglyph-wasm",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Browser image/gif/video to anaglyph 3-D converter (wasm + WebGPU + WebCodecs)",
    "scripts": {
        "serve": "python3 -m http.server 8000",
        "test": "node --test js/",
        "vendor": "cp node_modules/mediabunny/dist/bundles/mediabunny.min.mjs vendor/mediabunny.mjs && cp node_modules/mediabunny/dist/mediabunny.d.ts vendor/mediabunny.d.ts"
    },
    "dependencies": {
        "mediabunny": "^1.65.2"
    },
    "devDependencies": {
        "playwright": "1.65"
    }
}
